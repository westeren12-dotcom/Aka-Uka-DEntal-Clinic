{
  "name": "dental-clinic-bot",
  "version": "1.0.0",
  "description": "Production-ready Dental Clinic Telegram Bot + Admin Management System",
  "private": true,
  "scripts": {
    "dev:bot": "ts-node-dev --respawn --transpile-only src/bot/index.ts",
    "dev:api": "ts-node-dev --respawn --transpile-only src/api/index.ts",
    "dev:admin": "cd admin && npm run dev",
    "dev": "concurrently \"npm run dev:bot\" \"npm run dev:api\" \"npm run dev:admin\"",
    "build:bot": "tsc -p tsconfig.json",
    "build:admin": "cd admin && npm run build",
    "build": "npm run build:bot && npm run build:admin",
    "postinstall": "cd admin && npm install",
    "start": "node dist/bot/index.js",
    "start:api": "node dist/api/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.19.0",
    "telegraf": "^4.16.3",
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "zod": "^3.23.8",
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3",
    "axios": "^1.7.7",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.12",
    "@types/node-cron": "^3.0.11",
    "prisma": "^5.19.0",
    "typescript": "^5.5.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0"
  }
}
